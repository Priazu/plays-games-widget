{
  "name": "cysquale/plays-games-widget",
  "description": "Plays Games Widget - TikTok-style HTML5 game feed with player scores, leaderboards and personal rankings for TYPO3.",
  "type": "typo3-cms-extension",
  "license": "GPL-2.0-or-later",
  "homepage": "https://www.plays-games.com/",
  "keywords": [
    "TYPO3",
    "HTML5 games",
    "games",
    "infinite swipe",
    "game widget",
    "engagement",
    "leaderboard",
    "scores",
    "player rankings"
  ],
  "authors": [
    {
      "name": "Cysquale",
      "homepage": "https://www.plays-games.com/"
    }
  ],
  "require": {
    "php": ">=8.2",
    "typo3/cms-core": "^13.4"
  },
  "autoload": {
    "psr-4": {
      "Cysquale\\PlaysGamesWidget\\": "Classes/"
    }
  },
  "extra": {
    "typo3/cms": {
      "extension-key": "plays_games_widget"
    }
  }
}
